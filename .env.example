# Copy to .env. Supply your Neon connection string. Never commit credentials.
DATABASE_URL=postgres://user:password@host/database?sslmode=require
# Generate with: openssl rand -hex 32
MEDIA_OWNER_TOKEN=
# Use the public HTTPS origin behind your reverse proxy; loopback HTTP for development.
MEDIA_PUBLIC_URL=http://localhost:4000
MEDIA_PORT=4000
MEDIA_WORK_ROOT=./.media
MEDIA_WORKERS=2
MEDIA_CHUNK_CONCURRENCY=2
OPENAI_API_KEY=
GEMINI_API_KEY=
# Subscription adapters: dedicated writable homes, authenticated once through each native CLI.
# Docker Compose supplies /auth/codex and /auth/claude in persistent volumes.
# Do not point these at general-purpose agent homes or copy their refresh credentials.
# MEDIA_CODEX_HOME=/absolute/path/to/media-codex
# MEDIA_CLAUDE_HOME=/absolute/path/to/media-claude
# MEDIA_CODEX_PATH=codex
# MEDIA_CLAUDE_PATH=claude
MEDIA_CODEX_MODEL=gpt-6.1-sol
MEDIA_CLAUDE_MODEL=sonnet
MEDIA_SUBSCRIPTION_TIMEOUT_MS=600000
# Optional Google service account JSON, project and regional v2 recognizer.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_PROJECT_ID=
# GOOGLE_SPEECH_RECOGNIZER=projects/PROJECT/locations/REGION/recognizers/_
# TELEGRAM_PROXY_URL=http://telegram-proxy:8080
# TELEGRAM_PROXY_TOKEN=
# Per-site paths only; actual cookies stay outside this file and the image.
# YT_DLP_AUTH_JSON={"youtube":{"cookiesFromBrowser":"firefox:/browser/youtube"},"instagram":{"cookiesPath":"/cookies/instagram.txt"},"x":{"cookiesPath":"/cookies/x.txt"}}
# Custom trusted sites require BOTH hosts and exact extractor names.
# YT_DLP_SITES_JSON=[{"id":"example","hosts":["video.example.com"],"extractors":["Example"],"pathPattern":"^/video/[a-zA-Z0-9]+$"}]
